{
  "name": "winter-avatar",
  "version": "1.0.0",
  "type": "module",
  "description": "Standalone Minecraft skin renderer library for Node.js - renders 2D and 3D isometric avatars from Minecraft skins",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "npx ts-node test.ts"
  },
  "keywords": [
    "winter-avatar",
    "winteravatar",
    "minecraft",
    "cosmic-fi",
    "skin",
    "avatar",
    "renderer",
    "2d",
    "3d",
    "isometric",
    "head",
    "bust",
    "full-body"
  ],
  "author": "Cosmic-fi",
  "license": "MIT",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.44",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/axios": "^0.14.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cosmic-fi/winter-avatar"
  },
  "bugs": {
    "url": "https://github.com/cosmic-fi/winter-avatar/issues"
  },
  "homepage": "https://winteravatar.cosmicfi.dev/"
}